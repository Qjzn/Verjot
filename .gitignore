# Deny new root files by default. Add only reviewed source files below.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.md
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/CONTRIBUTING.md

# Reviewed artwork only. Runtime libraries are restored as documented in README.
!/assets/
/assets/*
!/assets/tingji.ico
!/assets/tingji-recording.ico
!/assets/tingji.svg
!/assets/tingji-recording.svg
!/assets/tingji.png
!/assets/tingji-recording.png
