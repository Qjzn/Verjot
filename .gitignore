!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/recording.png
!/assets/screenshots/quick-note.png
!/assets/screenshots/settings.png

# Personal configuration, captured audio, models, caches, logs, validation
# screenshots and build products remain local even when placed in subfolders.
